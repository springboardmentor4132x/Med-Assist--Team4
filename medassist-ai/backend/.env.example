# Copy this file to ".env" and edit the values
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/medassist
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Default admin account (created automatically on first start)
ADMIN_EMAIL=admin@medassist.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin
